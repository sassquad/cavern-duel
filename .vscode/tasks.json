{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "detail": "Tokenise src/*.bas into the HostFS app folder",
      "type": "shell",
      "command": "python3 tools/build.py build",
      "windows": { "command": "py -3 tools/build.py build" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "bbcbasic",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*): error: text line (\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      "presentation": { "reveal": "silent", "revealProblems": "onProblem" }
    },
    {
      "label": "Deploy to RPCEmu",
      "detail": "Build, then copy app/ to the HostFS folder in deploy.local.json",
      "type": "shell",
      "command": "python3 tools/build.py deploy",
      "windows": { "command": "py -3 tools/build.py deploy" },
      "problemMatcher": []
    },
    {
      "label": "Make release zip",
      "detail": "Build, then make dist/CavernDuel.zip to unpack on RISC OS",
      "type": "shell",
      "command": "python3 tools/build.py release",
      "windows": { "command": "py -3 tools/build.py release" },
      "problemMatcher": []
    },
    {
      "label": "Run on RISC OS 5",
      "detail": "Build, then start RPCEmu with the RISC OS Direct machine",
      "type": "shell",
      "command": "python3 tools/rpcemu.py direct",
      "windows": { "command": "py -3 tools/rpcemu.py direct" },
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Run on RISC OS 5.30",
      "detail": "Build, then start RPCEmu with the RISC OS 5.30 machine",
      "type": "shell",
      "command": "python3 tools/rpcemu.py 530",
      "windows": { "command": "py -3 tools/rpcemu.py 530" },
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Run on RISC OS 3.71",
      "detail": "Build, then start RPCEmu with the RISC OS 3.71 machine",
      "type": "shell",
      "command": "python3 tools/rpcemu.py 371",
      "windows": { "command": "py -3 tools/rpcemu.py 371" },
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Pull BASIC from app",
      "detail": "Detokenise ,ffb files edited inside RISC OS back into src/",
      "type": "shell",
      "command": "python3 tools/build.py pull",
      "windows": { "command": "py -3 tools/build.py pull" },
      "problemMatcher": []
    },
    {
      "label": "Check sources",
      "detail": "Confirm every source round-trips, then lint each program",
      "type": "shell",
      "command": "python3 tools/build.py check",
      "windows": { "command": "py -3 tools/build.py check" },
      "problemMatcher": []
    },
    {
      "label": "Test relay",
      "detail": "Run the tests for the internet relay, tools/relay.py",
      "type": "shell",
      "command": "python3 tools/test_relay.py",
      "windows": { "command": "py -3 tools/test_relay.py" },
      "problemMatcher": []
    },
    {
      "label": "Test tokeniser",
      "type": "shell",
      "command": "python3 tools/test_bbcbasic.py",
      "windows": { "command": "py -3 tools/test_bbcbasic.py" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
