# Runs tools/relay.py on a Linux server. See docs/relay-server.md.
[Unit]
Description=Cavern Duel relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -u /opt/cavernduel/relay.py --port 30123
Restart=on-failure
RestartSec=5

# A user made up for the service, with no login and no files of its own
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
